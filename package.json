{
  "name": "gmail-rules-installer",
  "version": "4.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "inventory": "node inventory.js",
    "inventory:big": "node inventory.js --months=24 --max=10000",
    "plan": "node gmail-organizer.js --plan",
    "backup": "node gmail-organizer.js --backup",
    "apply": "node gmail-organizer.js --apply",
    "restore": "node gmail-organizer.js --restore",
    "cleanup:legacy": "node gmail-organizer.js --cleanup-legacy"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "googleapis": "^144.0.0"
  }
}